class Solution {
public:
    vector<int> sortedSquares(vector<int>& arr) {
    int n = arr.size();
    vector<int> result(n);
    int i = 0;
    int j = n - 1 ;
    int k  = n - 1;
    while( i <= j){
        if( arr[i] * arr[i] > arr[j] * arr[j]){
            result [k] = arr[i] * arr[i];
            i++;
                    }
               else{
               result[k] = arr[j] * arr[j];
               j--;
                              }     
                              k--;
    }
    return result; 
    }
};
