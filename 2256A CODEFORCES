#include <iostream>
using namespace std;

int main() {
    int t;
    cin >> t;
    while (t--) {
        int arr[3];
        for (int i = 0; i < 3; i++) {
            cin >> arr[i];
        }

        
        for (int i = 0; i < 3; i++) {
            for (int j = i + 1; j < 3; j++) {
                if (arr[i] > arr[j]) {
                    swap(arr[i], arr[j]);
                }
            }
        }

        int a = arr[0];
        int b = arr[1];
        int c = arr[2];

        if (c >= a + b) {
            cout << b << " ";
        } else {
            cout << c - a << " ";
        }
    }
    return 0;
}
