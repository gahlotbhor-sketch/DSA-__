class Solution {
public:
    bool searchMatrix(vector<vector<int>>& matrix, int target) {
  

     int row = matrix.size();
     int columns = matrix[0].size();
      int low = 0;
      int high = matrix.size() * matrix[0].size() - 1; // rows and columns 
      


      while (low <= high){

        int mid = low + (high - low)/2;
  
        int row = mid/columns;
        int col = mid % columns;

        if(matrix[row][col] == target){
            return true;
        }
        else if(matrix[row][col] < target){
            low = mid + 1;
        }
        else{
            high = mid - 1;

        }
      }
      return false;
    }
};
